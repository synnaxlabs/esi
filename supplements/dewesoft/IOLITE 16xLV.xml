<?xml version="1.0" encoding="utf-8"?>
<!-- Supplements the Dewesoft ESI of the IOLITE 16xLV (IOLITE LV.xml). Written from the
     Dewesoft third-party EtherCAT masters manual, V26-3, section 6.1.6, without a card.
     Data types that the manual does not give follow those of the IOLITE 6xSTG. Not
     tested on hardware. -->
<EtherCATInfo Version="1.6">
  <Vendor>
    <Id>#xDEBE50F7</Id>
    <Name>Dewesoft</Name>
  </Vendor>
  <Descriptions>
    <Devices>
      <Device>
        <Type ProductCode="#xF8">IOLITE 16xLV</Type>
        <Name LcId="1033">IOLITE 16xLV</Name>
        <Profile>
          <Dictionary>
            <DataTypes>
              <DataType>
                <Name>DT_AD_TIMING</Name>
                <BaseType>UINT</BaseType>
                <BitSize>16</BitSize>
                <EnumInfo><Text>20 kS/s</Text><Enum>4</Enum></EnumInfo>
                <EnumInfo><Text>10 kS/s</Text><Enum>6</Enum></EnumInfo>
                <EnumInfo><Text>5 kS/s</Text><Enum>9</Enum></EnumInfo>
                <EnumInfo><Text>2 kS/s</Text><Enum>11</Enum></EnumInfo>
                <EnumInfo><Text>1 kS/s</Text><Enum>12</Enum></EnumInfo>
                <EnumInfo><Text>500 S/s</Text><Enum>13</Enum></EnumInfo>
                <EnumInfo><Text>200 S/s</Text><Enum>14</Enum></EnumInfo>
                <EnumInfo><Text>100 S/s</Text><Enum>15</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT_RANGE</Name>
                <BaseType>UINT</BaseType>
                <BitSize>16</BitSize>
                <EnumInfo><Text>200 V</Text><Enum>0</Enum></EnumInfo>
                <EnumInfo><Text>10 V</Text><Enum>1</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT8020</Name>
                <SubItem>
                  <SubIdx>1</SubIdx>
                  <Name>ADTiming</Name>
                  <Type>DT_AD_TIMING</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>2</SubIdx>
                  <Name>PowerONdefault</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>9</SubIdx>
                  <Name>ECAT0 App</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
              </DataType>
              <DataType>
                <Name>DT8040</Name>
                <SubItem>
                  <SubIdx>1</SubIdx>
                  <Name>Range</Name>
                  <Type>DT_RANGE</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
              </DataType>
            </DataTypes>
            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>AI Settings</Name>
                <Type>DT8020</Type>
              </Object>
              <Object>
                <Index>#x8040</Index>
                <Name>Channel 1 Settings</Name>
                <Type>DT8040</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <!-- Indices in Channels are those of input 1. Input n adds (n - 1) times
               IndexStep to each one. -->
          <Synnax Version="1">
            <Channels Count="16" IndexStep="1">
              <!-- From firmware 1.9.0.4, input n is a float in volts at 0x6030:n. The
                   ESI maps input n at 0x6020:n. The manual does not give the index of
                   the raw INT32 values of older firmware. -->
              <Entries Index="#x6030" SubIndex="1" SubIndexStep="1"/>
              <Entries Index="#x6020" SubIndex="1" SubIndexStep="1"/>
              <Setting Index="#x8040" SubIndex="1" Name="Range"/>
            </Channels>
            <DeviceSettings>
              <Setting Index="#x8020" SubIndex="1" Name="Sample rate (DC sync)"/>
            </DeviceSettings>
            <!-- ECAT0 App sets the card up alone on bus 1 (0, DC only), or in dual
                 mode (1): bus 1 to DewesoftX, bus 2 to the master. A change takes
                 effect after a reboot. With PowerONdefault (0x8020:02) at 1, writing 2
                 saves the settings. The cycles follow the manual's table for
                 standalone DC. -->
            <Mode Index="#x8020" SubIndex="9" Standalone="0"
                  SecondPort="#x00001000">
              <Value Value="0" AssignActivate="#x0700" Sync0Cycle="1000"
                     Sync1Cycle="1000000000"/>
              <Value Value="1" SharedWith="DewesoftX"/>
              <Save Index="#x8020" SubIndex="2" Value="2" When="1"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
    </Devices>
  </Descriptions>
</EtherCATInfo>
