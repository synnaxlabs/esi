<?xml version="1.0" encoding="utf-8"?>
<!-- Supplements the Dewesoft ESI of the IOLITE 4xCNT (IOLITE CNT.xml). Written from the
     Dewesoft third-party EtherCAT masters manual, V26-3, section 6.1.15, without a
     card. Data types that the manual does not give follow those of the IOLITE 6xSTG.
     Not tested on hardware. Value 1 of 0x8020:09, in which DewesoftX sets the module
     up, is left out, as no card was tested in it. The ESI writes it at startup on
     revision 0x00010000. -->
<EtherCATInfo Version="1.6">
  <Vendor>
    <Id>#xDEBE50F7</Id>
    <Name>Dewesoft</Name>
  </Vendor>
  <Descriptions>
    <Devices>
      <Device>
        <Type ProductCode="246">IOLITE 4xCNT</Type>
        <Name LcId="1033">IOLITE 4xCNT</Name>
        <Profile>
          <Dictionary>
            <DataTypes>
              <DataType>
                <Name>DT_CNT_AD_TIMING</Name>
                <BaseType>UINT</BaseType>
                <BitSize>16</BitSize>
                <EnumInfo><Text>20 kS/s</Text><Enum>20000</Enum></EnumInfo>
                <EnumInfo><Text>10 kS/s</Text><Enum>10000</Enum></EnumInfo>
                <EnumInfo><Text>5 kS/s</Text><Enum>5000</Enum></EnumInfo>
                <EnumInfo><Text>2 kS/s</Text><Enum>2000</Enum></EnumInfo>
                <EnumInfo><Text>1 kS/s</Text><Enum>1000</Enum></EnumInfo>
                <EnumInfo><Text>500 S/s</Text><Enum>500</Enum></EnumInfo>
                <EnumInfo><Text>100 S/s</Text><Enum>100</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT8020</Name>
                <SubItem>
                  <SubIdx>1</SubIdx>
                  <Name>ADTiming</Name>
                  <Type>DT_CNT_AD_TIMING</Type>
                  <BitSize>16</BitSize>
                </SubItem>
                <SubItem>
                  <SubIdx>9</SubIdx>
                  <Name>ECAT0 App</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                </SubItem>
              </DataType>
            </DataTypes>
            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>Device settings</Name>
                <Type>DT8020</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <Synnax Version="1">
            <!-- ADTiming holds the sample rate in S/s, in SM and DC sync. -->
            <DeviceSettings>
              <Setting Index="#x8020" SubIndex="1" Name="Module sample rate"/>
            </DeviceSettings>
            <!-- ECAT0 App sets the module up alone on bus 1 (0, DC only), or in dual
                 mode (1): bus 1 to DewesoftX, bus 2 to the master. The manual does not
                 say how the module keeps a change through a power restart. -->
            <Mode Index="#x8020" SubIndex="9" Standalone="0"
                  SecondBus="#x00001000">
              <Value Value="0" AssignActivate="#x0700" Sync0Cycle="1000000"
                     Sync1Cycle="1000000000"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
    </Devices>
  </Descriptions>
</EtherCATInfo>
