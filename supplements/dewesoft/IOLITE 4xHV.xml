<?xml version="1.0" encoding="utf-8"?>
<!-- Supplements the Dewesoft ESI of the IOLITE 4xHV (IOLITE HV.xml). Written from the
     Dewesoft third-party EtherCAT masters manual, V26-3, section 6.1.9, without a card.
     Data types that the manual does not give follow those of the IOLITE 6xSTG. Not
     tested on hardware. The section gives no input settings, so this file sets only
     the mode. -->
<EtherCATInfo Version="1.6">
  <Vendor>
    <Id>#xDEBE50F7</Id>
    <Name>Dewesoft</Name>
  </Vendor>
  <Descriptions>
    <Devices>
      <Device>
        <Type ProductCode="#xF0">IOLITEi 4xHV</Type>
        <Name LcId="1033">IOLITE 4xHV</Name>
        <Profile>
          <Dictionary>
            <DataTypes>
              <DataType>
                <Name>DT8020</Name>
                <SubItem>
                  <SubIdx>9</SubIdx>
                  <Name>ECAT0 App</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
              </DataType>
            </DataTypes>
            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>AI Settings</Name>
                <Type>DT8020</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <Synnax Version="1">
            <!-- ECAT0 App sets the card up alone on bus 1 (0, DC only), or in dual
                 mode (1): bus 1 to DewesoftX, bus 2 to the master. The section does
                 not give PowerONdefault, so there is no Save. The cycles follow the
                 manual's table for standalone DC. -->
            <Mode Index="#x8020" SubIndex="9" Standalone="0"
                  SecondBus="#x00001000">
              <Value Value="0" AssignActivate="#x0700" Sync0Cycle="1000"
                     Sync1Cycle="1000000000"/>
              <Value Value="1" SharedWith="DewesoftX"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
    </Devices>
  </Descriptions>
</EtherCATInfo>
