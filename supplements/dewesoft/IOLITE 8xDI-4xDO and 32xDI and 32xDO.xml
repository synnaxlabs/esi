                <EnumInfo><Text>DO 2</Text><Enum>2</Enum></EnumInfo>
                <EnumInfo><Text>DO 1 and 2</Text><Enum>3</Enum></EnumInfo>
                <EnumInfo><Text>DO 3</Text><Enum>4</Enum></EnumInfo>
                <EnumInfo><Text>DO 1 and 3</Text><Enum>5</Enum></EnumInfo>
                <EnumInfo><Text>DO 2 and 3</Text><Enum>6</Enum></EnumInfo>
                <EnumInfo><Text>DO 1, 2, and 3</Text><Enum>7</Enum></EnumInfo>
                <EnumInfo><Text>DO 4</Text><Enum>8</Enum></EnumInfo>
                <EnumInfo><Text>DO 1 and 4</Text><Enum>9</Enum></EnumInfo>
                <EnumInfo><Text>DO 2 and 4</Text><Enum>10</Enum></EnumInfo>
                <EnumInfo><Text>DO 1, 2, and 4</Text><Enum>11</Enum></EnumInfo>
                <EnumInfo><Text>DO 3 and 4</Text><Enum>12</Enum></EnumInfo>
                <EnumInfo><Text>DO 1, 3, and 4</Text><Enum>13</Enum></EnumInfo>
                <EnumInfo><Text>DO 2, 3, and 4</Text><Enum>14</Enum></EnumInfo>
                <EnumInfo><Text>DO 1 to 4</Text><Enum>15</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT8020</Name>
                <SubItem>
                  <SubIdx>1</SubIdx>
                  <Name>Output mode</Name>
                  <Type>DT_DIO_OUTPUT_MODE</Type>
                  <BitSize>32</BitSize>
                </SubItem>
                <SubItem>
                  <SubIdx>2</SubIdx>
                  <Name>Output Inverted</Name>
                  <Type>DT_DIO_INVERTED</Type>
                  <BitSize>32</BitSize>
                </SubItem>
                <SubItem>
                  <SubIdx>9</SubIdx>
                  <Name>ECAT0 App</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                </SubItem>
              </DataType>
            </DataTypes>
            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>Device settings</Name>
                <Type>DT8020</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <Synnax Version="1">
            <Revisions Mask="#xFFFF0000">#x00070000 #x00080000</Revisions>
            <!-- Output mode sets the outputs when the module goes to SAFE-OP after a
                 lost connection. Output Inverted holds one bit for each output, DO 1 in
                 bit 0. The manual gives 32-bit values, so both types are UDINT. -->
            <DeviceSettings>
              <Setting Index="#x8020" SubIndex="1" Name="Outputs on connection loss"/>
              <Setting Index="#x8020" SubIndex="2" Name="Inverted outputs"/>
            </DeviceSettings>
            <!-- ECAT0 App sets the module up alone on bus 1 (0, DC only), or in dual
                 mode (1): bus 1 to DewesoftX, bus 2 to the master. The manual does not
                 say how the module keeps a change through a power restart. -->
            <Mode Index="#x8020" SubIndex="9" Standalone="0"
                  SecondPort="#x00001000">
              <Value Value="0" AssignActivate="#x0700" Sync0Cycle="1000000"
                     Sync1Cycle="1000000000"/>
              <Value Value="1" SharedWith="DewesoftX"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
    </Devices>
  </Descriptions>
</EtherCATInfo>
