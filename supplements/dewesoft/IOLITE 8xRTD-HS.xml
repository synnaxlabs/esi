<?xml version="1.0" encoding="utf-8"?>
<!-- Supplements the Dewesoft ESI of the IOLITE 8xRTD-HS (IOLITE RTD.xml). Written from
     the Dewesoft third-party EtherCAT masters manual, V26-3, section 6.1.3 (the second
     one, after 6.1.4), without a card. Data types that the manual does not give follow
     those of the IOLITE 6xSTG. Not tested on hardware. -->
<EtherCATInfo Version="1.6">
  <Vendor>
    <Id>#xDEBE50F7</Id>
    <Name>Dewesoft</Name>
  </Vendor>
  <Descriptions>
    <Devices>
      <Device>
        <Type ProductCode="#xF2">IOLITEir 8xRTD-HS</Type>
        <Name LcId="1033">IOLITE 8xRTD-HS</Name>
        <Profile>
          <Dictionary>
            <DataTypes>
              <DataType>
                <Name>DT_SAMPLE_RATE</Name>
                <BaseType>UINT</BaseType>
                <BitSize>16</BitSize>
                <EnumInfo><Text>100 S/s</Text><Enum>100</Enum></EnumInfo>
                <EnumInfo><Text>200 S/s</Text><Enum>200</Enum></EnumInfo>
                <EnumInfo><Text>500 S/s</Text><Enum>500</Enum></EnumInfo>
                <EnumInfo><Text>1 kS/s</Text><Enum>1000</Enum></EnumInfo>
                <EnumInfo><Text>2 kS/s</Text><Enum>2000</Enum></EnumInfo>
                <EnumInfo><Text>5 kS/s</Text><Enum>5000</Enum></EnumInfo>
                <EnumInfo><Text>10 kS/s</Text><Enum>10000</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT_PT_TYPE</Name>
                <BaseType>UINT</BaseType>
                <BitSize>16</BitSize>
                <EnumInfo><Text>Pt100</Text><Enum>0</Enum></EnumInfo>
                <EnumInfo><Text>Pt200</Text><Enum>1</Enum></EnumInfo>
                <EnumInfo><Text>Pt500</Text><Enum>2</Enum></EnumInfo>
                <EnumInfo><Text>Pt1000</Text><Enum>3</Enum></EnumInfo>
                <EnumInfo><Text>Pt2000</Text><Enum>4</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT_MEAS_TYPE</Name>
                <BaseType>UINT</BaseType>
                <BitSize>16</BitSize>
                <EnumInfo><Text>Temperature</Text><Enum>0</Enum></EnumInfo>
                <EnumInfo><Text>Resistance</Text><Enum>1</Enum></EnumInfo>
                <EnumInfo><Text>Voltage</Text><Enum>2</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT_VM_RANGE</Name>
                <BaseType>UINT</BaseType>
                <BitSize>16</BitSize>
                <EnumInfo><Text>1 V</Text><Enum>0</Enum></EnumInfo>
                <EnumInfo><Text>100 mV</Text><Enum>1</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT_R_RANGE</Name>
                <BaseType>UINT</BaseType>
                <BitSize>16</BitSize>
                <EnumInfo><Text>1 kΩ</Text><Enum>0</Enum></EnumInfo>
                <EnumInfo><Text>10 kΩ</Text><Enum>1</Enum></EnumInfo>
              </DataType>
              <DataType>
                <Name>DT8020</Name>
                <SubItem>
                  <SubIdx>1</SubIdx>
                  <Name>Sample rate</Name>
                  <Type>DT_SAMPLE_RATE</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>9</SubIdx>
                  <Name>ECAT0 App</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
              </DataType>
              <DataType>
                <Name>DT8040</Name>
                <SubItem>
                  <SubIdx>1</SubIdx>
                  <Name>Pt type</Name>
                  <Type>DT_PT_TYPE</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>2</SubIdx>
                  <Name>Meas. type</Name>
                  <Type>DT_MEAS_TYPE</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>3</SubIdx>
                  <Name>VM range</Name>
                  <Type>DT_VM_RANGE</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>4</SubIdx>
                  <Name>R range</Name>
                  <Type>DT_R_RANGE</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
              </DataType>
            </DataTypes>
            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>AI Settings</Name>
                <Type>DT8020</Type>
              </Object>
              <Object>
                <Index>#x8040</Index>
                <Name>Channel 1 Settings</Name>
                <Type>DT8040</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <!-- Indices in Channels are those of input 1. Input n adds (n - 1) times
               IndexStep to each one. -->
          <Synnax Version="1">
            <Channels Count="8" IndexStep="1">
              <!-- Input n is a float at 0x6020:n, in the unit of the measurement. -->
              <Entries Index="#x6020" SubIndex="1" SubIndexStep="1"/>
              <Setting Index="#x8040" SubIndex="2" Name="Measurement"/>
              <!-- The manual ties the Pt type to 804x:05 (VM_range), as on the 8xTH.
                   This section sets the measurement mode at 804x:02. -->
              <Setting Index="#x8040" SubIndex="1" Name="RTD type">
                <ShowWhen Index="#x8040" SubIndex="2" Values="0"/>
              </Setting>
              <Setting Index="#x8040" SubIndex="3" Name="Voltage range">
                <ShowWhen Index="#x8040" SubIndex="2" Values="2"/>
              </Setting>
              <Setting Index="#x8040" SubIndex="4" Name="Resistance range">
                <ShowWhen Index="#x8040" SubIndex="2" Values="1"/>
              </Setting>
            </Channels>
            <!-- The value of Sample rate is the rate in S/s. -->
            <DeviceSettings>
              <Setting Index="#x8020" SubIndex="1" Name="Sample rate (DC sync)"/>
            </DeviceSettings>
            <!-- ECAT0 App sets the card up alone on bus 1 (0 DC), or in dual mode (1):
                 bus 1 to DewesoftX, bus 2 to the master. A change takes effect after a
                 reboot. The manual's mode table also gives 3 (SM) on bus 1, but its
                 ECAT0 App table and the ESI do not, so SM is not listed. The cycles
                 follow the manual's table for standalone DC. -->
            <Mode Index="#x8020" SubIndex="9" Standalone="0"
                  SecondBus="#x00001000">
              <Value Value="0" AssignActivate="#x0700" Sync0Cycle="1000"
                     Sync1Cycle="1000000000"/>
              <Value Value="1" SharedWith="DewesoftX"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
    </Devices>
  </Descriptions>
</EtherCATInfo>
