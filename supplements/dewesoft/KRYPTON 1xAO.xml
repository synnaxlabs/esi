<?xml version="1.0" encoding="utf-8"?>
<!-- Supplements the Dewesoft ESI of the KRYPTON 1xAO (KRYPTON AO.xml). Written from the
     Dewesoft third-party EtherCAT masters manual, V26-3, section 9.1.12, without a
     card. Data types that the manual does not give follow those of the IOLITE 6xSTG.
     Not tested on hardware. -->
