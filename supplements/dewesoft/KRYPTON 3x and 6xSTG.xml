        </Profile>
        <VendorSpecific>
          <!-- Indices in Channels are those of input 1. Input n adds (n - 1) times
               IndexStep to each one. Synnax writes the settings of a channel in the
               order they appear. -->
          <Synnax Version="1">
            <Revisions Mask="#xFFFFFF00">#x00000000</Revisions>
            <Channels Count="3" IndexStep="1">
              <!-- The unbuffered PDO 0x1A20 reads input n at 0x6030:n. The ESI
                   lists it only for revision 0x00000001. -->
              <Entries Index="#x6030" SubIndex="1" SubIndexStep="1"/>
              <Setting Index="#x8040" SubIndex="1" Name="Measurement"/>
              <Setting Index="#x8040" SubIndex="5" Name="Input"/>
              <Setting Index="#x8040" SubIndex="2" Name="Bridge">
                <ShowWhen Index="#x8040" SubIndex="1" Values="6 7"/>
              </Setting>
              <!-- The manual sets the excitation only here, from 0 V to 15 V. -->
              <Setting Index="#x8040" SubIndex="28" Name="Excitation voltage" Unit="V"
                       Min="0"/>
              <Setting Index="#x8040" SubIndex="3" Name="Range"/>
              <Setting Index="#x8040" SubIndex="4" Name="Low-pass filter"/>
              <Require Index="#x8040" SubIndex="5" Values="1"
                       Message="A bridge or potentiometer needs a differential input.">
                <When Index="#x8040" SubIndex="1" Values="6 7"/>
              </Require>
              <Require Index="#x8040" SubIndex="2" Values="1"
                       Message="A potentiometer needs the half bridge mode.">
                <When Index="#x8040" SubIndex="1" Values="7"/>
              </Require>
            </Channels>
            <!-- In SM sync, the card does not go to SAFE-OP with the
                 anti-aliasing filter on. -->
            <DeviceSettings>
              <Setting Index="#x8020" SubIndex="1" Name="Sample rate (DC sync)"/>
              <Setting Index="#x8020" SubIndex="8" Name="Anti-aliasing filter"/>
            </DeviceSettings>
            <!-- Buffered Input sets the card up for any master (0, SM or DC sync)
                 or for DewesoftX alone (1, DC buffered). With PowerONdefault
                 (0x8020:02) at 0, the card saves each change. At 1, writing 2
                 saves the settings. -->
            <Mode Index="#x8020" SubIndex="7" Standalone="0">
              <Value Value="0"/>
              <Value Value="1" Shared="true"/>
              <Save Index="#x8020" SubIndex="2" Value="2" When="1"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
