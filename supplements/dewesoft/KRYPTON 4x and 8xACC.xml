            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>Device settings</Name>
                <Type>DT8020</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <Synnax Version="1">
            <Revisions Mask="#xFFFFFF00">#x00000000</Revisions>
            <!-- No channel settings: neither the manual nor the ESI gives the
                 object index of the input values. -->
            <!-- In SM sync, the card does not go to SAFE-OP with the
                 anti-aliasing filter on. -->
            <DeviceSettings>
              <Setting Index="#x8020" SubIndex="1" Name="Sample rate (DC sync)"/>
              <Setting Index="#x8020" SubIndex="8" Name="Anti-aliasing filter"/>
            </DeviceSettings>
            <!-- Buffered Input sets the card up for any master (0, SM or DC sync)
                 or for DewesoftX alone (1, DC buffered). With PowerONdefault
                 (0x8020:02) at 0, the card saves each change. At 1, writing 2
                 saves the settings. -->
            <Mode Index="#x8020" SubIndex="7" Standalone="0">
              <Value Value="0"/>
              <Value Value="1" Shared="true"/>
              <Save Index="#x8020" SubIndex="2" Value="2" When="1"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
