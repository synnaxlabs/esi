            <Revisions Mask="#xFFFFFF00">#x00000000</Revisions>
            <!-- The module has one input type and one range (±50 V), so there are no
                 channel settings. -->
            <DeviceSettings>
              <Setting Index="#x8020" SubIndex="1" Name="Module sample rate (DC sync)"/>
            </DeviceSettings>
            <!-- Buffered Input 0 is unbuffered, in SM or DC sync. 1 is the DC buffered
