<?xml version="1.0" encoding="utf-8"?>
<!-- Supplements the Dewesoft ESI of the KRYPTONi 4xDI (KRYPTON DIO.xml). Written from
     the Dewesoft third-party EtherCAT masters manual, V26-3, section 9.1.16, without a
     card. Data types that the manual does not give follow those of the IOLITE 6xSTG.
     Not tested on hardware. -->
<EtherCATInfo Version="1.6">
  <Vendor>
    <Id>#xDEBE50F7</Id>
    <Name>Dewesoft</Name>
  </Vendor>
  <Descriptions>
    <Devices>
      <Device>
        <Type ProductCode="#x9B" RevisionNo="#x00000001">KRYPTONi 4xDI</Type>
        <Name LcId="1033">KRYPTONi 4xDI</Name>
        <Profile>
          <Dictionary>
            <DataTypes>
              <DataType>
                <Name>DT8020</Name>
                <SubItem>
                  <SubIdx>7</SubIdx>
                  <Name>Buffered Input</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                  <Flags><Access>rw</Access></Flags>
                </SubItem>
              </DataType>
            </DataTypes>
            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>Module settings</Name>
                <Type>DT8020</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <Synnax Version="1">
            <!-- Product code 0x9B is also the IOLITEi 4xDI (revision 0x0010). -->
            <Revisions Mask="#xFFFF0000">#x00000000</Revisions>
            <!-- The manual gives no setting for the inputs, so there is no Channels
                 block. -->
            <!-- Buffered Input 0 is unbuffered, in SM or DC sync. 1 is the DC buffered
                 mode of DewesoftX. -->
            <Mode Index="#x8020" SubIndex="7" Standalone="0">
              <Value Value="0"/>
              <Value Value="1" Shared="true"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
    </Devices>
  </Descriptions>
</EtherCATInfo>
