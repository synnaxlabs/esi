<?xml version="1.0" encoding="utf-8"?>
<!-- Supplements the Dewesoft ESI of the KRYPTONi 8xTH and 16xTH (KRYPTON TH.xml).
     Written from the Dewesoft third-party EtherCAT masters manual, V26-3, section
     9.1.1, without a card. Data types that the manual does not give follow those of the
     IOLITE 6xSTG. Not tested on hardware. -->
<EtherCATInfo Version="1.6">
  <Vendor>
    <Id>#xDEBE50F7</Id>
    <Name>Dewesoft</Name>
  </Vendor>
  <Descriptions>
    <Devices>
      <Device>
        <Type ProductCode="#x64">KRYPTONi 8xTH</Type>
        <Name LcId="1033">KRYPTONi 8xTH</Name>
        <Profile>
          <Dictionary>
            <DataTypes>
              <DataType>
                <Name>DT8020</Name>
                <SubItem>
                  <SubIdx>7</SubIdx>
                  <Name>Buffered Input</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                </SubItem>
              </DataType>
            </DataTypes>
            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>Device settings</Name>
                <Type>DT8020</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <Synnax Version="1">
            <Revisions Mask="#xFFFFFF00">#x00000000</Revisions>
            <!-- No channel settings: neither the manual nor the ESI gives the
                 object index of the input values. -->
            <!-- Buffered Input sets the card up for any master (0, SM or DC sync)
                 or for DewesoftX alone (1, DC buffered). -->
            <Mode Index="#x8020" SubIndex="7" Standalone="0">
              <Value Value="0"/>
              <Value Value="1" OnlyReadBy="DewesoftX"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
      <Device>
        <Type ProductCode="#x64">KRYPTONi 16xTH</Type>
        <Name LcId="1033">KRYPTONi 16xTH</Name>
        <Profile>
          <Dictionary>
            <DataTypes>
              <DataType>
                <Name>DT8020</Name>
                <SubItem>
                  <SubIdx>7</SubIdx>
                  <Name>Buffered Input</Name>
                  <Type>UINT</Type>
                  <BitSize>16</BitSize>
                </SubItem>
              </DataType>
            </DataTypes>
            <Objects>
              <Object>
                <Index>#x8020</Index>
                <Name>Device settings</Name>
                <Type>DT8020</Type>
              </Object>
            </Objects>
          </Dictionary>
        </Profile>
        <VendorSpecific>
          <Synnax Version="1">
            <Revisions Mask="#xFFFFFF00">#x00010000</Revisions>
            <!-- No channel settings: neither the manual nor the ESI gives the
                 object index of the input values. -->
            <Mode Index="#x8020" SubIndex="7" Standalone="0">
              <Value Value="0"/>
              <Value Value="1" OnlyReadBy="DewesoftX"/>
            </Mode>
          </Synnax>
        </VendorSpecific>
      </Device>
    </Devices>
  </Descriptions>
</EtherCATInfo>
